{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan-executor ledger",
  "type": "object",
  "required": [
    "version",
    "plan_path",
    "input_type",
    "created_at",
    "units"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "plan_path": {
      "type": "string"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "staged",
        "whole"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "weight",
          "status",
          "attempts",
          "depends",
          "parallel_group",
          "last_error",
          "checkpoint_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "weight": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "depends": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parallel_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "part": {
            "type": "string",
            "description": "Part id (a, b, …) of a staged unit taken from a part's tasks or its checkpoint; absent for whole plans, hand-written parts and old ledgers"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoint_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line_start": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line_end": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deviations from the unit's text agreed with the engineer (unit-finish --note)"
          },
          "external": {
            "type": "array",
            "description": "The unit's **External:** lines at unit-begin: what was permitted and by whom",
            "items": {
              "type": "object",
              "required": ["env", "access", "kind", "consent", "confirmed", "source"],
              "properties": {
                "env": {"type": ["string", "null"]},
                "access": {"enum": ["read", "write", null]},
                "kind": {"enum": ["test", "prod", null]},
                "consent": {"enum": ["run", "task", "deny", null]},
                "confirmed": {"type": "boolean"},
                "source": {"enum": ["spec", "session", null]}
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 of the plan or roadmap the units came from; plan-drift check"
    },
    "run_id": {
      "type": "string",
      "description": "Snapshot namespace: refs/plan-executor/<run_id>/<unit>"
    },
    "workdir": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_head": {
      "type": "string",
      "description": "HEAD sha at the first ledger-init (\"\" for an unborn HEAD); commit-run's mixed-files and head-moved checks. Absent in older ledgers and outside git"
    },
    "journal": {
      "type": ["object", "null"],
      "required": ["path", "plan"],
      "properties": {
        "path": {"type": "string", "description": "Absolute path of the chain journal <goal>-chain.json"},
        "plan": {"type": "string", "description": "Plan id in the journal: the master plan file name without .md"}
      },
      "description": "Chain journal of the run (plan-brainstorming journal_path_for); null when plan-brainstorming is not installed alongside or the journal cannot be opened"
    },
    "expected_tree": {
      "type": ["string", "null"],
      "description": "Git tree the working tree must match before the next unit (foreign-changes check in unit-begin)"
    },
    "foreign_events": {
      "type": "array",
      "description": "Files changed outside the run between units and the engineer's decision (accept-changes, checkpoint-restore --paths --exec-dir)",
      "items": {
        "type": "object",
        "required": ["at", "paths", "decision"],
        "properties": {
          "at": {"type": "string"},
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "status"],
              "properties": {
                "path": {"type": "string"},
                "status": {"type": "string", "enum": ["added", "modified", "deleted"]}
              }
            }
          },
          "decision": {"type": "string", "enum": ["accepted", "restored"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "settings": {
      "type": ["object", "null"],
      "description": "plan-brainstorming resolve_settings output at ledger-init (chain, environments with read/write rights, backlog); null when plan-brainstorming is not installed alongside"
    },
    "settings_source": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": ["string", "null"]}
      },
      "description": "The spec or plan the settings came from; a changed sha256 on resume is settings-drift"
    },
    "consents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {"read": {"type": "boolean"}, "write": {"type": "boolean"}},
        "additionalProperties": false
      },
      "description": "Run-scope consents given during execution (consent command), per environment; cleared on resume"
    }
  }
}
